[mysqld]
# 默认字符集和排序规则
character-set-server = utf8mb4
collation-server = utf8mb4_general_ci

# 确保客户端连接也使用 utf8mb4
skip-character-set-client-handshake
init-connect = 'SET NAMES utf8mb4'

# 可选：禁用严格模式（根据应用需求）
# sql_mode = "NO_ENGINE_SUBSTITUTION"

[client]
default-character-set = utf8mb4

[mysql]
default-character-set = utf8mb4
